
class Solution {
    public int minRotations(String s) {
        int count = 0;
        int prev = 0;
        int i = 0;

        while (i < s.length()) {
            int curr = s.charAt(i) - '0';
            int diff = Math.abs(curr - prev);

            count += Math.min(diff, 10 - diff);
            prev = curr;
            i++;
        }

        return count;
    }
}
