class Solution {
    static final int mod=1000000000+7;
    long comb[][];
    public int numOfWays(int[] nums) {
        int n=nums.length;
        comb=new long[n+1][n+1];
        for(int i=0;i<n;i++){
            comb[i][0]=1;
            comb[i][i]=1;
            for(int j=1;j<i;j++){
                comb[i][j]=(comb[i-1][j-1]+comb[i-1][j])%mod;

            }
        }
        List<Integer> list=new ArrayList<>();
        for(int num:nums){
            list.add(num);
        }
        return (int)((solve(list)-1+mod)%mod);
    }
    public long solve(List<Integer> list){
        if(list.size()<=2){
            return 1;
        }
        int root=list.get(0);
        List<Integer> right=new ArrayList<>();
        List<Integer> left=new ArrayList<>();
        for(int i=1;i<list.size();i++){
            if(list.get(i)<root){
                left.add(list.get(i));
            }
            else{
                right.add(list.get(i));
            }
        }
        long leftway=solve(left);
        long rightway=solve(right);
        long ways=comb[list.size()-1][left.size()];
        ways=ways*leftway%mod;
        ways=ways*rightway%mod;
        return ways;
    }
}
