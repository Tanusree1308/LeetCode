class Solution {
    public boolean isPalindrome(String s) {
        StringBuilder sb = new StringBuilder();

        int i = 0;

        while (i < s.length()) {
            char ch = s.charAt(i);

            if (Character.isLetterOrDigit(ch)) {
                sb.append(Character.toLowerCase(ch));
            }

            i++;
        }

        int left = 0;
        int right = sb.length() - 1;

        while (left < right) {
            if (sb.charAt(left) != sb.charAt(right)) {
                return false;
            }

            left++;
            right--;
        }

        return true;
    }
}
