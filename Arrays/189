class Solution {
    public void rotate(int[] nums, int k) {
        k = k%nums.length;
        right(0, nums.length - 1, nums);
        right(0, k - 1, nums);
        right(k, nums.length - 1, nums);

    }
    public void right(int start,int end,int[] nums){
        int left=start;
        int right=end;
        while(left<=right){
            int temp=nums[left];
            nums[left]=nums[right];
            nums[right]=temp;
            left++;
            right--;
        }
    }
}
