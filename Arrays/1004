class Solution {
    public int longestOnes(int[] nums, int k) {
        int left=0;
        int max=0;
        int target=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]==0){
                target++;
            }
            while(target>k){
                if(nums[left]==0){
                    target--;
                }
                left++;
            }
            max=Math.max(i-left+1,max);
        }
        return max;
    }
}
